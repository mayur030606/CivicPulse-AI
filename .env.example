# ---------------------------------------------------------------------------
# Copy this file to `.env` in the repository root.
# Both the backend (pydantic-settings) and the frontend (Vite envDir) read it.
# ---------------------------------------------------------------------------

# ---- Backend: application ----
APP_NAME=CivicPulse AI API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Backend: MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=civicpulse
DB_PASSWORD=change-me
DB_NAME=civicpulse

# ---- Backend: Gnani AI ----
# Prisma v3.0 speech-to-text: https://docs.gnani.ai/api/STT/speech-to-text
# GNANI_API_KEY is sent only server-side in the X-API-Key-ID header.
GNANI_BASE_URL=https://api.vachana.ai
GNANI_API_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE_CODE=indic-auto
GNANI_STT_TIMEOUT_SECONDS=60
GNANI_STT_MAX_UPLOAD_MB=10

# Timbre text-to-speech: https://docs.gnani.ai/api/TTS/tts-inference
# Supported models: timbre-v2.5 (default) and timbre-v3.0.
GNANI_TTS_BASE_URL=https://api.vachana.ai
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_TIMEOUT_SECONDS=60

# ---- Backend: YOLO ----
# A local path or a model name that Ultralytics can resolve/download.
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.35
# Image upload validation and bounded inference.
YOLO_MAX_UPLOAD_MB=10
YOLO_MAX_IMAGE_WIDTH=8192
YOLO_MAX_IMAGE_HEIGHT=8192
YOLO_MAX_IMAGE_PIXELS=25000000
YOLO_MAX_CONCURRENCY=2

# ---- Backend: authentication cookies ----
# Opaque server-side sessions; no cookie-signing secret is required.
# Secure cookies are forced when ENVIRONMENT=production even if this is false.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=480
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# AUTH_COOKIE_NAME=civicpulse_session
# CSRF_COOKIE_NAME=civicpulse_csrf
# CSRF_HEADER_NAME=X-CSRF-Token

# ---- Backend: rate limiting / abuse protection ----
# The default memory backend is per-process: use it for local development or a
# single worker. Multi-worker production deployments should install
# backend/requirements-redis.txt and set RATE_LIMIT_BACKEND=redis.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/0
# RATE_LIMIT_REDIS_TIMEOUT_SECONDS=1.0
# RATE_LIMIT_KEY_PREFIX=civicpulse:ratelimit
# Only trust X-Forwarded-For / X-Real-IP when the direct peer is one of these
# proxy IPs or CIDR ranges. Leave empty when there is no reverse proxy.
RATE_LIMIT_TRUSTED_PROXIES=
RATE_LIMIT_INCIDENTS_CREATE_LIMIT=5
RATE_LIMIT_INCIDENTS_CREATE_WINDOW_SECONDS=600
RATE_LIMIT_TRACKING_LOOKUP_LIMIT=30
RATE_LIMIT_TRACKING_LOOKUP_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_LIMIT=30
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_VOICE_TRANSCRIBE_LIMIT=10
RATE_LIMIT_VOICE_TRANSCRIBE_WINDOW_SECONDS=60
RATE_LIMIT_VOICE_SPEAK_LIMIT=20
RATE_LIMIT_VOICE_SPEAK_WINDOW_SECONDS=60
RATE_LIMIT_AI_UNDERSTAND_LIMIT=30
RATE_LIMIT_AI_UNDERSTAND_WINDOW_SECONDS=60
RATE_LIMIT_AI_ANALYZE_IMAGE_LIMIT=10
RATE_LIMIT_AI_ANALYZE_IMAGE_WINDOW_SECONDS=60

# ---- Frontend ----
# Relative URL uses the Vite dev proxy (recommended for local development).
# For a deployed backend use the full URL, e.g. https://api.example.org/api/v1
# Anything prefixed with VITE_ is exposed to the browser: never put secrets here.
VITE_API_BASE_URL=/api/v1
